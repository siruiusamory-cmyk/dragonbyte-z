---
import {
  project,
  programmeDone,
  programmeTotal,
  programmePercent,
  buildoutDone,
  buildoutTotal,
  buildoutPercent,
} from "../data/project";
import Window from "./Window.astro";
import Icon from "./Icon.astro";

const stages = [
  {
    title: "Foundation, research and authoring",
    state: "Complete",
    pct: programmePercent,
    note: `${programmeDone} of ${programmeTotal} milestones`,
    tone: "complete",
    icon: "done",
  },
  {
    title: "DragonByte Z buildout",
    state: "Complete",
    pct: buildoutPercent,
    note: `${buildoutDone} of ${buildoutTotal} capabilities`,
    tone: "complete",
    icon: "done",
  },
  {
    title: "Playable LOG1 content in the real engine",
    state: "Not started",
    pct: 0,
    note: project.acceptanceTarget,
    tone: "future",
    icon: "todo",
  },
] as const;
---

<Window id="progress" title={`Editor capabilities: ${buildoutPercent}%`} icon="live" labelledby="progress-title" class="copy-dialog">
  <h2 id="progress-title" class="dialog-title">Building DragonByte Z, one capability at a time</h2>
  <p class="copy-route">From <b>engine research</b> to <b>a complete authoring toolkit</b></p>
  <p class="copy-remaining">Editor capabilities remaining: {buildoutTotal - buildoutDone} of {buildoutTotal}</p>

  <div class="progress-meter">
    <div
      class="bar"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow={buildoutPercent}
      aria-valuetext={`${buildoutPercent} percent of editor capabilities shipped`}
      aria-label="Editor capability coverage"
      aria-describedby="progress-scope progress-caveat"
    >
      <span style={`--pct: ${buildoutPercent}%`}></span>
    </div>
    <span class="progress-pct">{buildoutPercent}%</span>
  </div>
  <p class="progress-ratio">{buildoutDone} of {buildoutTotal} editor capabilities shipped</p>
  <p class="progress-scope" id="progress-scope">
    This figure counts editor capabilities only. The acceptance target below has not started,
    so the project itself is not complete.
  </p>

  <h3 class="details-label">More details</h3>
  <ol class="stages">
    {stages.map((stage) => (
      <li class:list={["stage", `is-${stage.tone}`]}>
        <Icon name={stage.icon} class="stage-icon" />
        <span class="stage-body">
          <b class="stage-title">{stage.title}</b>
          <small class="stage-note">{stage.note}</small>
        </span>
        <b class="stage-pct">{stage.pct}%</b>
        <span class="stage-state">{stage.state}</span>
      </li>
    ))}
  </ol>

  <p class="fine" id="progress-caveat">{project.progressCaveat}</p>
</Window>
